{
  "name": "eventwise-ai",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "EventWise AI - An Intelligent, Personalized Event Planning Assistant",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-size-budget.mjs",
    "start": "tsx server.mjs",
    "backup": "tsx scripts/backup.ts backup",
    "restore": "tsx scripts/backup.ts restore",
    "analyze": "node scripts/run-analyze.mjs",
    "check:budget": "node scripts/check-size-budget.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest-axe": "^3.5.9",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "vitest": "^5.0.5"
  }
}
