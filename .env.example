# ==============================================================================
# EventWise AI Environment Configuration
# ==============================================================================
# OPTIONAL: Google Gemini API Key for local development only.
# In production builds, this ambient variable is ignored by the client bundle
# to prevent exposing keys in client-side JavaScript.
#
# FOR PRODUCTION:
# 1. Use an in-memory session key entered by the user in the UI (never saved to storage).
# 2. OR deploy the serverless proxy (api/gemini.ts) and set VITE_GEMINI_PROXY_URL below.
#
# HARDENING BEST PRACTICES:
# - In Google Cloud / Google AI Studio console:
#   * Restrict API key to 'Generative Language API' scope only.
#   * Restrict key using HTTP referrer restrictions matching your deployment URL.
#   * Rotate any key immediately if it was ever committed, pasted, or deployed.
# ==============================================================================
VITE_GEMINI_API_KEY=your_dev_gemini_api_key_here

# OPTIONAL: URL of your deployed serverless proxy (e.g. /api/gemini on Vercel/Netlify)
# When set, the client sends requests to this backend proxy instead of calling Google directly.
# VITE_GEMINI_PROXY_URL=https://your-domain.com/api/gemini

