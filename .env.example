# ==============================================================================
# EventWise AI Environment Configuration
# ==============================================================================
# SECURITY FIRST: API keys are NEVER bundled into client-side JS bundles.
#
# 1. Ephemeral In-Memory Keys: Users can paste a Google Gemini API key directly
#    into the AI modal. The key is kept strictly in volatile React state/memory,
#    never stored in localStorage, sessionStorage, cookies, or logs.
# 2. Server-Side Proxy: When deployed, backend routes (api/gemini.ts) read the
#    server-only environment variable GEMINI_API_KEY. It is never exposed to the client.
# ==============================================================================
# Server-side Gemini API key (optional; only used by serverless backend proxy)
# GEMINI_API_KEY=your_server_gemini_api_key_here

# ACCOUNTS & LOGIN (required in production)
# ==============================================================================
# Random secret used to sign session cookies. Generate with:  openssl rand -hex 32
AUTH_SECRET=replace_with_at_least_32_random_characters

# Database for accounts and cloud-synced plans. Easiest on Vercel:
#   Project -> Storage -> Marketplace -> Upstash Redis -> Connect
# which injects these (the legacy KV_REST_API_URL / KV_REST_API_TOKEN names also work).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alternative without a database: a server with a PERSISTENT DISK (e.g. a Render disk mounted at /var/data).
# Accounts and the session signing key are stored as files there.
# DATA_DIR=/var/data
#
# REQUIRED in production (Redis or DATA_DIR). Without a database every serverless cold start forgets all accounts, so
# people who registered cannot sign in again. Production now refuses to start accounts without Redis.
# Only for throwaway demos you can opt back in to the volatile in-memory store:
# ALLOW_MEMORY_STORE=true

# Password-reset emails (https://resend.com). Without these, reset links are only
# shown on screen in development and never in production.
RESEND_API_KEY=
EMAIL_FROM="EventWise AI <no-reply@your-domain.com>"

# Public site URL used in reset links (defaults to the Vercel production URL).
# APP_URL=https://your-domain.com


# Optional: comma-separated emails that are always administrators. (The very first account that signs up
# becomes the administrator automatically; use this to recover or add admins without touching the database.)
# ADMIN_EMAILS=you@example.com

# Optional: Slack / Discord / Teams incoming-webhook URL. The API pings it (max once a minute) on unexpected errors.
# ALERT_WEBHOOK_URL=

# Backups: pm run backup writes backups/eventwise-<time>.json, pm run restore -- file.json loads one back.
